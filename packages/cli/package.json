{
  "name": "shrike",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Verified dead-code cleanup: whole-graph orphan delta, verified deletion batches, and portable receipts.",
  "bin": {
    "shrike": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "files": [
    "src"
