    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@shrike/agent": "workspace:*",
    "@shrike/receipts": "workspace:*",
    "@shrike/verifier": "workspace:*"
  },
  "devDependencies": {
    "@shrike/testkit": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
