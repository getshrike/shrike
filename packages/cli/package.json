{
  "name": "shrike",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Verified dead-code cleanup: whole-graph orphan delta, verified deletion batches, and portable receipts.",
  "license": "MIT",
  "bin": {
    "shrike": "./bin/shrike.mjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@shrike/agent": "workspace:*",
    "@shrike/receipts": "workspace:*",
    "@shrike/verifier": "workspace:*"
  },
  "devDependencies": {
    "@shrike/testkit": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
