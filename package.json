{
  "name": "shrike-monorepo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run build:engine && pnpm run build:ts",
    "build:engine": "cargo build --release -p shrike-engine",
    "build:ts": "pnpm run build:types && pnpm run build:cli && pnpm run build:action",
    "build:types": "tsc -p packages/receipts/tsconfig.build.json && tsc -p packages/verifier/tsconfig.build.json && tsc -p packages/agent/tsconfig.build.json && tsc -p packages/testkit/tsconfig.build.json",
    "build:cli": "node scripts/build-cli.mjs",
    "build:action": "node scripts/build-action.mjs",
    "typecheck": "tsc -b packages/cli packages/verifier packages/receipts packages/agent packages/testkit packages/protocol",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
    "test:rust": "cargo test --workspace",
    "test:node": "node --test \"packages/**/*.test.mjs\"",
    "test:differential": "node scripts/differential.mjs",
    "test:differential:glob": "node scripts/differential.mjs --fixture fixtures/differential-glob",
    "test:differential:update": "node scripts/differential.mjs --update",
    "test:e2e": "node scripts/e2e-prune.mjs",
    "check": "pnpm run build:ts && node scripts/check.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:install": "node scripts/test-install.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "corpus": "node scripts/corpus-runner.mjs",
    "fixtures:delta": "node scripts/delta-fixtures.mjs",
    "fixtures:verify": "node scripts/verify-fixtures.mjs",
    "bench": "node benchmarks/harness.mjs",
    "bench:report": "node benchmarks/report-build.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
