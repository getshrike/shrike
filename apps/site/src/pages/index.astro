---
import AnnouncementBar from "../components/AnnouncementBar.astro";
import CtaSection from "../components/CtaSection.astro";
import DeadCodeGuide from "../components/DeadCodeGuide.astro";
import FeatureScroll from "../components/FeatureScroll.astro";
import Hero from "../components/Hero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Shrike: Delete dead code with proof"
  description="Shrike is an open-source CLI that finds dead code left by PRs and AI agents, deletes it in verified batches, and leaves a receipt. It runs locally."
>
  <AnnouncementBar />
  <SiteHeader />
  <main id="main">
    <Hero />
    <FeatureScroll />
    <DeadCodeGuide />
    <CtaSection />
  </main>
  <SiteFooter />
</BaseLayout>
