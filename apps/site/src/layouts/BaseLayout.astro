---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const FALLBACK_SITE = "https://getshrike.dev";
const site = Astro.site ?? new URL(FALLBACK_SITE);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/brand/og-card.png", site).href;
const logo = new URL("/brand/icon-512.png", site).href;
const github = "https://github.com/getshrike/shrike";
const npm = "https://www.npmjs.com/package/getshrike";
const docs = "https://docs.getshrike.dev";
const profiles = [github, npm, docs];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.origin}/#organization`,
      name: "Shrike",
      url: `${site.origin}/`,
      logo,
      sameAs: profiles,
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      url: `${site.origin}/`,
      name: "Shrike",
      inLanguage: "en",
      publisher: { "@id": `${site.origin}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical}#software`,
      name: "Shrike",
      description,
      url: canonical,
      downloadUrl: npm,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, Windows",
      softwareVersion: "1.1.0",
      isAccessibleForFree: true,
      license: "https://opensource.org/licenses/MIT",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      sameAs: profiles,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/brand/site.webmanifest" />
    <link
      rel="sitemap"
      type="application/xml"
      href="/sitemap-index.xml"
      title="Sitemap"
    />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shrike" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Shrike — delete dead code with proof"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Shrike — delete dead code with proof"
    />

    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="/fonts/OverusedGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeistMono-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="min-h-screen bg-[#FCFCFC] text-[#252525] antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
