---
const href = "https://github.com/getshrike/shrike";
---

<div class="w-full bg-[#202020]">
  <div class="mx-auto max-w-[1800px] px-6 min-[900px]:px-8">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="group block w-full"
    >
      <div
        class="flex cursor-pointer items-center justify-center py-2 text-sm font-medium"
      >
        <div class="hidden items-center gap-0 transition-all duration-200 sm:flex">
          <span
            class="font-medium tracking-tight text-white transition-colors duration-200 group-hover:text-[#cccccc]"
          >
            Shrike 1.0.1 is out
          </span>
          <span
            class="ml-4 flex items-center gap-1 font-medium text-[#AAAAAA] transition-colors duration-200 group-hover:text-[#cccccc]"
          >
            View on GitHub
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-200 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </span>
        </div>

        <div
          class="flex min-w-0 flex-1 items-center justify-center gap-0 transition-all duration-200 sm:hidden"
        >
          <span
            class="min-w-0 truncate font-medium tracking-tight text-white transition-colors duration-200 group-hover:text-[#cccccc]"
          >
            Shrike 1.0.1 is out
          </span>
          <span
            class="ml-2 flex shrink-0 items-center gap-1 whitespace-nowrap text-[#AAAAAA] transition-colors duration-200 group-hover:text-[#cccccc]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-200 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </span>
        </div>
      </div>
    </a>
  </div>
</div>
