  }

  .feature-rail[data-nav-theme="light"] {
    --rail-active: #171717;
    --rail-inactive: #6b6b6b;
    --rail-hover: #525252;
    --rail-label: rgba(23, 23, 23, 0.65);
  }

  .feature-nav-label {
    color: var(--rail-label);
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .feature-nav-link {
    position: relative;
    display: block;
    padding-left: 16px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.375;
    letter-spacing: -0.02em;
    color: var(--rail-inactive);
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .feature-nav-link:hover {
    color: var(--rail-hover);
  }

  .feature-nav-link[aria-current="true"] {
    color: var(--rail-active);
  }

  .feature-nav-marker {
    position: absolute;
    top: 5px;
    left: 0;
    width: 7px;
    height: 9px;
    opacity: 0;
    transform: translateX(-2px);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .feature-nav-link[aria-current="true"] .feature-nav-marker {
    opacity: 1;
    transform: translateX(0);
  }

  .feature-scroll[data-enhanced] [data-feature-reveal] {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(18px);
  }

  .feature-scroll[data-enhanced] [data-feature-reveal].is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
    transition:
      opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .feature-terminal .terminal-screen {
    padding: 14px 14px 28px;
    font-size: 10.5px;
    line-height: 1.55;
  }

  .feature-terminal .terminal-dot {
    width: 8px;
    height: 8px;
  }

  @media (min-width: 640px) {
    .feature-terminal .terminal-screen {
      padding: 18px 18px 32px;
      font-size: 12px;
    }

    .feature-terminal .terminal-dot {
      width: 10px;
      height: 10px;
    }
  }

  @media (min-width: 1024px) {
    .feature-terminal .terminal-screen {
      padding: 22px 24px 36px;
      font-size: 14px;
    }

    .feature-terminal .terminal-dot {
      width: 11px;
      height: 11px;
    }
  }

  @media (min-width: 1536px) {
    .feature-terminal .terminal-screen {
      padding: 24px 28px 40px;
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-scroll[data-enhanced] [data-feature-reveal] {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }

    .feature-nav-marker {
      transition: none;
    }
  }

  @media (scripting: none) {
    .feature-scroll[data-enhanced] [data-feature-reveal] {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>
